{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cinematic Studio",
  "version": "0.1.0",
  "identifier": "com.cinematicstudio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Cinematic Studio", "width": 1440, "height": 900, "minWidth": 1180, "minHeight": 720, "center": true, "dragDropEnabled": true, "backgroundColor": "#070708" }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: studio: http://studio.localhost; media-src 'self' blob: studio: http://studio.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Cinematic Studio",
    "shortDescription": "Cinematic AI video production studio",
    "longDescription": "Direct, generate, edit and export cinematic AI video. Projects stay on this computer; generation runs on the ComfyUI server you configure.",
    "category": "Video",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "resources/ffmpeg/": "resources/ffmpeg/" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["English", "Arabic"], "displayLanguageSelector": false, "startMenuFolder": "Cinematic Studio" }
    }
  }
}
