# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
APP_NAME=Mashhad Studio
# Long random string. Encrypts provider keys stored from the admin panel and signs
# public asset URLs. REQUIRED in production (in development one is generated in data/).
APP_SECRET=
# Public https origin of this server (needed for share links and for providers
# that must fetch reference images by URL, e.g. Luma). Example: https://studio.example.com
PUBLIC_BASE_URL=
DATA_DIR=./data
# Set true when served over https
COOKIE_SECURE=false
# The first account registered with this email becomes admin (otherwise: the first account).
ADMIN_EMAIL=

# ── Video providers (server side only — never shipped to the browser) ─────
# Keys can also be entered in the admin panel; those are stored encrypted in the DB.
RUNWAY_API_KEY=
LUMA_API_KEY=
GEMINI_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# ── Audio provider (optional) ─────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── AI director (optional). Without it the built-in rule-based director is used.
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-opus-5-5

# ── Limits ────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=200
MAX_PROJECT_SECONDS=120
QUEUE_CONCURRENCY=4
